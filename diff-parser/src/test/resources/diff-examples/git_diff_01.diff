+   *
+   * @return true if static import
+   */
+  public boolean isStatic() {
+    return isStatic;
+  }
+
+  /**
+   * Checks if this is a wildcard import.
+   *
+   * @return true if wildcard import
+   */
+  public boolean isAsterisk() {
+    return isAsterisk;
+  }
+}
