{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.format.organizeImports": true,
    "java.format.onType": true,
    // "java.format.settings.profile": "GoogleStyle",
    // "java.format.settings.url": ".eclipse-java-google-style.xml",
    // Use the google formatter plugin from
    // https://marketplace.visualstudio.com/items?itemName=mmilic.java-google-format
    "editor.formatOnSave": true,
    "[java]": {
        "editor.defaultFormatter": "mmilic.java-google-format"
    },
    "java.search.scope": "all"
}